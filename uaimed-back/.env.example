NODE_ENV=development
PORT=3333

# PostgreSQL local via docker-compose
DATABASE_URL="postgresql://docker:docker@localhost:5432/uaimed"

JWT_SECRET="sua-chave-super-secreta"
JWT_EXPIRE_IN="1h"
REFRESH_TOKEN_SECRET="outra-chave-super-secreta-diferente"
REFRESH_TOKEN_EXPIRE_IN="30d"
BCRYPT_ROUNDS=10
FRONTEND_URL="http://localhost:19000"

# Chave raiz (32 bytes em base64) usada para derivar as chaves de
# criptografia de CPF, CNPJ e dados bancários. Gere a sua com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="defina-uma-chave-de-32-bytes-em-base64"

# Senha do usuário admin criado pelo seed (prisma/seed.ts). Opcional em dev
# (usa "senha123" se não definida); o seed nunca roda com NODE_ENV=production.
SEED_ADMIN_PASSWORD="senha123"
